# project_gestion_asistencias_vacaciones_insip/backend/.env.development

APP_NAME=gestion_asistencias_vacaciones_insip
APP_ENV=development
APP_KEY=base64:bP6PHj92v4qd+WNbi+pouYb2Y0PuEXK/zkJUag9iQ5I=
APP_DEBUG=false
APP_URL=http://localhost:8000

# --- Configuración de la Base de Datos (SQL Server Dockerizado) ---
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=gestion_asistencias_vacaciones_insip_db
DB_USERNAME=sa
DB_PASSWORD=12345678

# --- Configuración del Cache Driver ---
# CRÍTICO: Usar 'file' durante la construcción para evitar dependencias de DB.
# Una vez en producción, podrías considerar 'redis' o 'memcached'.
CACHE_DRIVER=file

# --- Configuración de Sesiones ---
# Similar al caché, si usas 'database' para sesiones, podría causar problemas durante la construcción.
# 'file' es seguro para la fase de construcción.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Configuración de Colas (Queues) ---
# Ya que mencionaste queues, si planeas usar el driver 'database' para queues,
# también requerirá una conexión a la DB. Para la construcción, 'sync' o 'null'
# son opciones seguras. En producción, lo más común es 'redis' o 'database'.
QUEUE_CONNECTION=database # o 'database' si quieres persistencia y ya está lista la DB, pero podría fallar la construcción.

# --- Configuración de Correo para Producción ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=b180022@unach.mx
MAIL_PASSWORD=ttkajhxsxvmpumgs
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_RH="colombio_0320@outlook.com"

# --- URLs del Frontend de Producción ---
APP_FRONTEND_URL=http://localhost:5173
APP_FRONTEND_LOGIN_URL="${APP_FRONTEND_URL}/auth/login"
APP_FRONTEND_RESET_URL="${APP_FRONTEND_URL}/auth/reset-password"
APP_FRONTEND_ACCOUNT_URL="${APP_FRONTEND_URL}/profile/security"

# --- API Info Configuration ---
API_VERSION="1.0.0"
API_DESCRIPTION="API para la gestión integral de solicitudes y saldos de vacaciones de empleados."
API_CONTACT_EMAIL="soporte@inisip.com"
API_CONTACT_PHONE="+502 1234-5678"
API_SUPPORT_URL="https://inisip.com/docs/api-vacaciones"
API_STATUS=operativo

# --- Configuración de CORS ---
# Para múltiples orígenes, sepáralos con una coma sin espacios.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174


